# .gitignore for .NET (ASP.NET Core) + Vue 3 (Vite) project

##########################
# .NET / ASP.NET Core
##########################

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
*.rsuser
.suo
*.user

# MSTest / NUnit / xUnit test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
coverage/
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Publish output
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# Rider
.idea/
*.sln.iml

# dotnet tool manifest (keep if used)
# .config/dotnet-tools.json

# ASP.NET Core secrets
**/appsettings.*.local.json
**/secrets.json

# Entity Framework migrations (keep if you want to track them)
# Migrations/

# DNX / project.lock
project.lock.json
project.fragment.lock.json
artifacts/

##########################
# Node / npm
##########################

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.npm
*.tgz
.yarn-integrity

# yarn v2+
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# dotenv
.env
.env.local
.env.*.local

# Runtime data
pids
*.pid
*.pid.lock

##########################
# Vue 3 / Vite
##########################

# Build output
dist/
dist-ssr/

# Vite cache
.vite/
**/.vite/

# Vue language tools / Volar
*.vue.d.ts

# TypeScript
*.tsbuildinfo

# Vitest coverage
coverage/
*.lcov
.nyc_output

# ESLint / Stylelint cache
.eslintcache
.stylelintcache

##########################
# OS / Editor
##########################

.DS_Store
Thumbs.db
*.tmp
*~
~$*

# VS Code workspace settings (keep .vscode/extensions.json if desired)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/